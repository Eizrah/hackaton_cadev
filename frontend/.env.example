# URL de Django, sans le suffixe /api (déjà présent dans les routes du frontend).
VITE_API_URL=http://localhost:8000

# api : l'assistant et l'aide des cours interrogent Django ; demo : aide locale.
VITE_AGENT_MODE=api

# demo : profil et récupération simulés ; api : connexion et récupération via Django.
# Voir docs/INTEGRATION_DJANGO.md pour les endpoints requis.
VITE_AUTH_MODE=api
