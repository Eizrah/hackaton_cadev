# ⚠️  CONFIGURATION DE PRODUCTION
# Copiez ce fichier en .env dans backend/Bcadev/ et remplissez avec vos vraies valeurs

# Django - SÉCURITÉ CRITIQUE
CLE_SECRET=CHANGEZ-MOI-GENERER-AVEC-python-c-import-secrets-print-secrets-token-urlsafe-50
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com,IP-du-serveur

# Database - PostgreSQL
DB_NAME=cadev_prod
DB_USER=cadev_user
DB_PASSWORD=MOT-DE-PASSE-FORT-MINIMUM-20-CARACTERES
DB_HOST=db
DB_PORT=5432

# OAuth - Google
GOOGLE_CLIENT_ID=votre-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-google-client-secret

# OAuth - GitHub
GITHUB_CLIENT_ID=votre-github-oauth-client-id
GITHUB_CLIENT_SECRET=votre-github-client-secret

# APIs d'Intelligence Artificielle
GROQ_API_KEY=gsk_votre_cle_groq_api
OPENROUTER_API_KEY=sk-or-v1-votre-cle-openrouter-api
GROQ_MODEL_VERIFICATION=llama-3.3-70b-versatile
GROQ_MODEL_ASSISTANT=llama-3.3-70b-versatile
OPENROUTER_MODEL_FALLBACK=mistralai/mistral-7b-instruct

# URLs
FRONTEND_URL=https://votre-domaine.com
BACKEND_URL=https://votre-domaine.com

# Email - Configuration SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-app-16-caracteres
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@cadev.com

# CORS - Sécurité
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Session et Cookies - Sécurité
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ⚠️  COMMENT OBTENIR LES CLÉS:

# 1. CLE_SECRET Django:
#    python -c "import secrets; print(secrets.token_urlsafe(50))"

# 2. Google OAuth:
#    https://console.cloud.google.com/apis/credentials
#    - Créer un projet
#    - Activer Google+ API
#    - Créer des identifiants OAuth 2.0
#    - Ajouter les URI de redirection autorisées

# 3. GitHub OAuth:
#    https://github.com/settings/developers
#    - New OAuth App
#    - Ajouter l'URL de callback

# 4. GROQ API:
#    https://console.groq.com/keys
#    - Créer un compte
#    - Générer une clé API

# 5. OpenRouter API:
#    https://openrouter.ai/keys
#    - Créer un compte
#    - Générer une clé API

# 6. Email (Gmail):
#    https://myaccount.google.com/apppasswords
#    - Activer la validation en 2 étapes
#    - Générer un mot de passe d'application
