# ========================================
# CONFIGURATION PRODUCTION - SYSTALINK
# ========================================
# ⚠️ IMPORTANT : Créer un fichier .env.production avec ces variables
# et remplacer TOUTES les valeurs par les vraies clés de production

# Django
CLE_SECRET=CHANGER_PAR_UNE_CLE_SECRETE_LONGUE_ET_ALEATOIRE
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Base de données PostgreSQL
DB_NAME=cadev_prod
DB_USER=cadev_user
DB_PASSWORD=MOT_DE_PASSE_POSTGRES_SECURISE
DB_HOST=db
DB_PORT=5432

# OAuth Google
GOOGLE_CLIENT_ID=VOTRE_CLIENT_ID_GOOGLE
GOOGLE_CLIENT_SECRET=VOTRE_SECRET_GOOGLE

# OAuth GitHub
GITHUB_CLIENT_ID=VOTRE_CLIENT_ID_GITHUB
GITHUB_CLIENT_SECRET=VOTRE_SECRET_GITHUB

# Frontend URL
FRONTEND_URL=https://votre-domaine.com

# IA - Groq & OpenRouter
GROQ_API_KEY=VOTRE_CLE_GROQ
OPENROUTER_API_KEY=VOTRE_CLE_OPENROUTER
GROQ_MODEL_VERIFICATION=openai/gpt-oss-20b
GROQ_MODEL_ASSISTANT=openai/gpt-oss-20b
OPENROUTER_MODEL_FALLBACK=mistralai/mistral-7b-instruct

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@votre-domaine.com
